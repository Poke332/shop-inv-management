# Frontend environment — Vite loads .env / .env.local at the frontend/ root.
# Only VITE_-prefixed variables are exposed to the app code (import.meta.env).
# Copy this file to .env.local (gitignored) and adjust for your setup.

# Base URL of the backend API the http data layer talks to (no trailing slash).
# The code default is http://localhost:3000/api (backend direct); point it at
# the dev proxy instead (http://localhost:3001/api) when the proxied dev stack
# is what you verify against.
VITE_API_BASE_URL=http://localhost:3000/api
