# Mobile app environment — Expo inlines EXPO_PUBLIC_* variables into the app
# at build time. Copy this file to .env (gitignored) and adjust the values.

# Base URL of the backend API, including the /api prefix. The app builds its
# requests as <EXPO_PUBLIC_API_URL>/products and <EXPO_PUBLIC_API_URL>/products/:id.
# When unset, config.js falls back to this default (http://localhost:3000/api).
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Testing from a real phone or tablet on your local network? "localhost" only
# resolves on the machine running the API, so a device on the LAN cannot reach
# it. Point the URL at that machine's LAN IP instead, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000/api
# (the device and the API server must be on the same network).
