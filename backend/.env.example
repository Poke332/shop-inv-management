# Backend environment — every npm script loads .env via `node --env-file=.env`.
# Copy this file to .env (gitignored) and adjust; the defaults below are the
# values the code falls back to when a variable is unset, except DATABASE_URL,
# which is required and has no fallback.

# HTTP port for the API server. Default: 3000.
PORT=3000

# The single browser origin allowed by CORS — the dev server that talks to the API.
# Default: http://localhost:5174.
FRONTEND_ORIGIN=http://localhost:5174

# Postgres connection string (Supabase direct connection):
#   postgres://postgres:PASSWORD@db.REF.supabase.co:5432/postgres
# Paste your Supabase connection string into .env; .env stays gitignored.
# The server refuses to boot without it.
DATABASE_URL=postgres://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# Supabase project base URL, shown on the dashboard under Settings -> API,
# e.g. https://REF.supabase.co. Used to reach the Storage API for product
# images — at runtime (uploads) and by the seed (which uploads each seeded
# product's source image, so the seed also needs both SUPABASE_ vars).
SUPABASE_URL=https://CHANGE_ME.supabase.co

# Service-role key for the Supabase storage bucket `product-images`. The
# backend provisions the bucket itself on first image upload (createBucket,
# public — Supabase Storage API) and uploads with this key; an anon key
# cannot create buckets, so this must be the service-role key. It bypasses
# row-level policy and grants admin access to the project, so it stays
# server-side only: never load it into the browser and never commit it.
# If your project blocks bucket creation from the API, create the bucket
# manually instead (Storage -> New bucket, public, read-only for anon).
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Shared JWT signing secret. The code has no safe default and refuses to boot
# with fewer than 32 characters (middleware/auth.js). The 41-char placeholder
# below is non-secret by definition — safe for local dev, rotate it in any
# deployment that is not your own machine.
JWT_SECRET=dev-only-0123456789abcdef0123456789abcdef

# JWT claim values used when signing/verifying session tokens.
# Defaults: sunset-api / sunset-web.
JWT_ISSUER=sunset-api
JWT_AUDIENCE=sunset-web

# Optional: set to test when running the suite — the HTTP listener is skipped.
# NODE_ENV=test

# --- AI chat assistant (POST /api/chat) ---------------------------------------
# Anthropic API key (https://console.anthropic.com). Server-side only: never put
# it in the frontend or mobile .env files. Without it the chat endpoint answers
# 503 "not configured" and the rest of the API keeps working.
ANTHROPIC_API_KEY=CHANGE_ME

# Model used by the assistant. Default: claude-haiku-5-5 (fast and cheap).
# Switch to claude-sonnet-5-5 for stronger reasoning on long comparisons.
CHAT_MODEL=claude-haiku-5-5

# Max chat requests per IP per minute (protects your API bill). Default: 20.
CHAT_RATE_LIMIT_PER_MIN=20
