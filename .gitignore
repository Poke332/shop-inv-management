__pycache__/
*.pyc
# Mockup build output — regenerable via _mockup-build/build_html.py +
# rebuild_docs_png.sh (recipe: docs/RENDER.md); keep out of git.
_mockup-build/out/
_mockup-build/verify/
_mockup-build/final/
_mockup-build/recheck/
# One-off diagnostic / probe scripts (worker scratch, not part of the build recipe).
_mockup-build/_*
_mockup-build/probe_*.py
# Vite frontend (frontend/ at repo root) — node_modules + build output are regenerable.
frontend/node_modules/
frontend/dist/
# GitNexus code-intelligence index — regenerable via `gitnexus analyze`.
.gitnexus/
# GitNexus-generated AI-tool artifacts (repo-specific skills + agent docs).
# AGENTS.md is rewritten by `gitnexus analyze` every run — untracked, local-only.
.claude/
CLAUDE.md
AGENTS.md
# One-off frontend verify harnesses (worker scratch, not part of the build):
# named per phase in the past; the pattern below covers verify-p<N>.mjs for
# every future phase so no per-file line is ever needed again.
frontend/verify-*.mjs
frontend/gutter-check.mjs
# Logs + local env (never commit credentials / local config).
*.log
npm-debug.log*
.env
.env.*
# Editor / OS noise (mirrors frontend/.gitignore at the repo root).
.vscode/
.idea/
.DS_Store
